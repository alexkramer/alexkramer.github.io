---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { formatDate } from '../../lib/dates'

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<Base title="Writing, Alex Kramer" description="Engineering notes on Grails, Groovy and Hibernate, 2014–2016.">
  <div class="wrap">
    <section class="section">
      <div class="row">
        <div class="text">
          <h1>Writing</h1>
          <p class="lede">Engineering notes from my years writing Grails and Groovy, 2014–2016.</p>
        </div>
      </div>
      {
        posts.map((post) => (
          <article class="row post">
            <p class="label">
              <time datetime={post.data.date.toISOString().slice(0, 10)}>{post.data.date.getUTCFullYear()}</time>
            </p>
            <div class="text">
              <h2>
                <a href={`/blog/${post.id}.html`}>{post.data.title}</a>
              </h2>
              <p class="lede">
                {formatDate(post.data.date)}
                {post.data.categories.length > 0 && `, ${post.data.categories.join(', ')}`}
              </p>
            </div>
          </article>
        ))
      }
    </section>
  </div>
</Base>

<style>
  h1 {
    font-size: var(--step-3);
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .section > .row:first-child {
    margin-bottom: 2.5rem;
  }

  .post + .post {
    margin-top: 1.75rem;
  }

  h2 {
    font-family: var(--sans);
    font-size: var(--step-0);
    font-weight: 700;
    line-height: 1.4;
  }

  .post .text > * + * {
    margin-top: 0.15rem;
  }

  .post .lede {
    font-size: var(--step--1);
  }
</style>
