---
import { getImage } from 'astro:assets'
import headshot from '../assets/headshot.jpg'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  type?: 'website' | 'article'
  jsonLd?: object
}

const { title, description, type = 'website', jsonLd } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = await getImage({ src: headshot, width: 600, height: 600, format: 'jpg' })
const ogImageUrl = new URL(ogImage.src, Astro.site)

const nav = [
  { href: '/#experience', label: 'Experience' },
  { href: '/blog/', label: 'Writing' },
  { href: '/#contact', label: 'Contact' },
  { href: '/assets/resume.pdf', label: 'Resume' },
]
const path = Astro.url.pathname
const isCurrent = (href: string) => href === '/blog/' && path.startsWith('/blog/')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Alex Kramer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="600" />
    <meta property="og:image:height" content="600" />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;700&family=Besley:wght@400..700&display=swap"
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="site-name" href="/">Alex Kramer</a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>&copy; {new Date().getFullYear()} Alex Kramer, Boston area</p>
        <ul>
          <li><a href="mailto:ackramer19@gmail.com">Email</a></li>
          <li><a href="https://linkedin.com/in/alexckramer/">LinkedIn</a></li>
          <li><a href="https://github.com/alexkramer">GitHub</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
